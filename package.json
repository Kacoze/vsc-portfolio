{
  "name": "vsc-portfolio",
  "version": "1.0.0",
  "description": "Portfolio site styled as a VS Code workspace",
  "private": true,
  "author": "Kamil Kozieradzki",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite src",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.2.1",
    "jsdom": "^29.0.2",
    "lighthouse": "^13.1.0",
    "playwright-lighthouse": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  }
}
